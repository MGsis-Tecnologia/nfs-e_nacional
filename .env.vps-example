# ============ BANCO DE DADOS PostgreSQL ============
# Troque por credenciais reais só na VPS (nunca commite a senha real)
DB_USER=postgres
DB_PASSWORD=troque_por_uma_senha_forte_e_unica
DB_NAME=nfse
DB_PORT=5432

# ============ APLICAÇÃO Node.js ============
# production = otimizado para VPS
NODE_ENV=production

# Porta interna da aplicação (não mude)
PORT=3001

# 0.0.0.0 = aceita conexões de qualquer origem (necessário para Docker)
HOST=0.0.0.0

# ============ SEGURANÇA - JWT ============
# IMPORTANTE: Gere uma chave nova com:
# openssl rand -base64 32
# OU
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=GERE_UMA_CHAVE_ALEATORIA_COM_OS_COMANDOS_ACIMA

# ============ CORS - Permissões de Origem ============
# Substitua "seu-dominio.com" pelo seu domínio real
# Exemplos:
#   https://nfse.sua-empresa.com
#   https://app.sua-empresa.com
#   http://localhost:3000 (desenvolvimento)
CORS_ORIGIN=https://seu-dominio.com

# ============ DOCKER COMPOSE ============
# Porta externa (qual porta acessar de fora)
# 3000 = http://seu-dominio.com:3000
# 80 = http://seu-dominio.com (precisa de Nginx como proxy)
# 443 = https://seu-dominio.com (precisa de Nginx + SSL)
APP_PORT=3000
