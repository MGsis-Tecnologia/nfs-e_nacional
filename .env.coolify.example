# ============================================
# Variáveis de ambiente para deploy no Coolify
# ============================================
# Build pack da aplicação: Dockerfile (NÃO "Docker Compose" — o
# docker-compose.yml e o .env.vps-example/.env.production são só
# para deploy manual numa VPS crua, sem Coolify).
#
# Configure essas variáveis na aba "Environment Variables" da
# aplicação no Coolify. Não precisa criar um arquivo .env de verdade,
# é só pra referência de quais variáveis preencher e com que valor.
#
# IMPORTANTE: desmarque "Available at Buildtime" nas 4 variáveis abaixo
# (deixe só "Runtime"). Nenhuma delas é necessária durante o build, e o
# Coolify passa variáveis de buildtime como ARG do Docker — isso já
# quebrou o build uma vez (NODE_ENV=production como ARG faz o npm pular
# devDependencies, e o "prisma generate" falha com "prisma: not found")
# e também expõe JWT_SECRET/DATABASE_URL no histórico da imagem à toa.

# ---- Banco de dados ----
# 1. Crie o Postgres como um recurso separado no Coolify:
#    + New Resource -> Database -> PostgreSQL
# 2. Copie a connection string interna gerada por ele (aba
#    "Configuration" do recurso) e cole aqui:
DATABASE_URL=postgresql://usuario:senha@nome-do-servico-postgres:5432/postgres

# ---- Segurança ----
# Chave para assinar os tokens de sessão do admin.
# Gere uma nova (não reaproveite esta): openssl rand -base64 32
JWT_SECRET=gere_uma_chave_aleatoria_longa_e_unica_aqui

# ---- CORS ----
# Domínio público que o Coolify atribuiu à aplicação (ou seu domínio
# customizado, se configurou um). Precisa bater exatamente com a URL
# usada para acessar a aplicação, senão o frontend carrega mas as
# chamadas à API são bloqueadas por CORS.
CORS_ORIGIN=https://seu-dominio.com

# ---- Aplicação ----
NODE_ENV=production

# ---- NÃO precisa configurar ----
# PORT e HOST não precisam ser definidos aqui: os defaults do
# server.js (3001 / 0.0.0.0) já são o que o Dockerfile e o
# HEALTHCHECK (/health) esperam.
#
# Em "Ports Exposes" na aplicação do Coolify, use: 3001
