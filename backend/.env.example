# SQLite - sem configuração necessária!
# O banco é criado automaticamente em ./nfse.db

# Segredo para assinar os tokens de sessão do admin (gerado pelo wizard)
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# Servidor
PORT=3001
HOST=127.0.0.1

# NFS-e Nacional (nfse.gov.br)
# NFSE_PADRAO determina qual sistema usar: "nfse-gov-br" (novo nacional) ou "foz-iguacu" (legacy)
NFSE_PADRAO=nfse-gov-br

# URLs dos ambientes (não é necessário alterar, apenas para referência)
# Homologação: https://www.producaorestrita.nfse.gov.br/api/v1/contribute/issqn
# Produção: https://www.nfse.gov.br/api/v1/contribute/issqn
